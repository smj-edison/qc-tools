#!/bin/python3

"""
Convert a Milo *.out trajectory to a multi-frame XYZ on stdout.

Usage:
    milo_out_to_xyz < TS45_MILO_12297959.out > TS45_MILO_12297959.xyz

It extracts every "### Step N: T fs" block that is followed by
"Coordinates (angstrom):" and writes them as concatenated XYZ frames,
preserving the original coordinate formatting.
"""

import re
import sys

STEP_RE = re.compile(r"^### Step (\d+):\s+([0-9.]+)\s+fs")
COORD_HEADER_RE = re.compile(r"^\s*Coordinates \(angstrom\):")


def main() -> None:
    lines = sys.stdin.readlines()
    i = 0

    while i < len(lines):
        match = STEP_RE.match(lines[i])
        if not match:
            i += 1
            continue

        step, time = match.group(1), match.group(2)

        # Move to the "Coordinates (angstrom):" line for this step.
        i += 1
        while i < len(lines) and not COORD_HEADER_RE.match(lines[i]):
            i += 1
        if i >= len(lines):
            break
        i += 1

        # Collect atom lines until a blank line or a non-coordinate line.
        coords = []
        while i < len(lines):
            line = lines[i]
            stripped = line.strip()
            if not stripped:
                break

            parts = stripped.split()
            if len(parts) != 4:
                break

            _, x, y, z = parts
            try:
                float(x)
                float(y)
                float(z)
            except ValueError:
                break

            # The leading indentation from Milo is removed to match the
            # existing XYZ style; the rest of the line is kept verbatim.
            coords.append(line.lstrip().rstrip())
            i += 1

        if not coords:
            continue

        print(len(coords))
        print(f"Step {step}: {time} fs")
        for atom_line in coords:
            print(atom_line)

    # The script is intentionally silent on stderr so stdout is a clean XYZ stream.
    return


if __name__ == "__main__":
    main()
