#!/bin/python3

import os
import subprocess
from pathlib import Path
import argparse


def parse_nprocshared(section_lines: list[str]) -> int:
    """Return the %nprocshared value in a single link section's lines."""
    nprocshared_lines: list[str] = [line for line in section_lines if "%nprocshared" in line.casefold()]
    if len(nprocshared_lines) == 0:
        raise ValueError("No %nprocshared line found in a link section (Gaussian would silently default to 1 processor).")
    if len(nprocshared_lines) > 1:
        raise ValueError(f"Multiple %nprocshared lines found in the same link section: {nprocshared_lines}")
    return int(nprocshared_lines[0].split('=')[-1])


def parse_mem_mb(section_lines: list[str]) -> int:
    """Return the %mem value (in MB) in a single link section's lines."""
    mem_lines: list[str] = [line for line in section_lines if "%mem" in line.casefold()]
    if len(mem_lines) == 0:
        raise ValueError("No %mem line found in a link section (Gaussian would silently fall back to its own default).")
    if len(mem_lines) > 1:
        raise ValueError(f"Multiple %mem lines found in the same link section: {mem_lines}")
    mem_str: str = mem_lines[0].split('=')[-1].casefold().strip()
    mem_num: int = int(''.join([c for c in mem_str if c.isnumeric()]))
    if mem_str.endswith("mb"):
        return mem_num
    elif mem_str.endswith("gb"):
        return mem_num * 1000
    else:
        raise ValueError("Unrecognized unit in mem specification. Check input.")


parser: argparse.ArgumentParser = argparse.ArgumentParser(description="Create and run Gaussian job from .gjf or .com file")
parser.add_argument("file", type=Path, help="Name of .gjf or .com file")
parser.add_argument("-t", "--time", type=str, help="Walltime for job (format d-hh:mm:ss)", required=True)
parser.add_argument("-q", "--qos", type=str.lower, choices=["normal","standby", "test"], help="Quality of service (\"normal\", \"standby\", or \"test\")", required=True)
args = parser.parse_args()

inputfile: Path = Path(args.file)
if not inputfile.exists():
    raise ValueError(f"{args.file} does not exist.")
elif inputfile.suffix != ".gjf" and inputfile.suffix != ".com":
    raise ValueError(f"{args.file} is not a .gjf or .com file.")

inputfile_text: str = inputfile.read_text()
inputfile_lines: list[str] = [line for line in inputfile_text.split('\n')]

## Splitting into link sections (Gaussian's --Link1-- syntax) up front, since
## Gaussian does not carry %-commands forward between link sections - each
## one needs its own %nprocshared/%mem/%chk or it silently falls back to
## Gaussian's own defaults rather than erroring. Doing this split once makes
## every per-section field available for both the job's resource request and
## cross-section consistency warnings below.
link_sections: list[list[str]] = [[]]
for line in inputfile_lines:
    if line.strip().casefold() == "--link1--":
        link_sections.append([])
    else:
        link_sections[-1].append(line)

section_nprocs: list[int] = [parse_nprocshared(section) for section in link_sections]
section_mem: list[int] = [parse_mem_mb(section) for section in link_sections]

## Finding nprocshared and mem (in MB) across all link sections
nprocs: int = max(section_nprocs)
mem: int = max(section_mem)
mem = int(mem * 1.5)

## Warning if link sections request different resources from one another
if len(link_sections) > 1:
    if len(set(section_nprocs)) > 1:
        print(f"Warning: %nprocshared differs between link sections: {section_nprocs}")
    if len(set(section_mem)) > 1:
        print(f"Warning: %mem differs between link sections (in MB): {section_mem}")

## Checking that any %chk lines point to a file matching the input file's name
chk_lines: list[str] = [line for line in inputfile_lines if "%chk" in line.casefold()]
expected_chk: str = inputfile.with_suffix(".chk").name
for line in chk_lines:
    chk_name: str = Path(line.split('=')[-1].strip()).name
    print(f"Using checkpoint {chk_name}")
    if chk_name != expected_chk:
        print(f"    (note that this differs from job file name, {inputfile})")

## Checking for a blank line at end of input file and inserting if one is not found
last_chars: str = inputfile_text[-2:]
if last_chars != "\n\n":
    print(f"Warning: {inputfile} did not end with a blank line, appending one.")
    inputfile.write_text(inputfile_text + '\n')

## Creating, writing, submitting, and deleting .job file
jobfile: Path = inputfile.with_suffix(".job")

jobfile_lines: str = f"""#!/bin/bash
#SBATCH --time={args.time}
#SBATCH --nodes=1
#SBATCH --ntasks-per-node={nprocs}
#SBATCH --mem={mem}MB
#SBATCH --qos={args.qos}
#SBATCH --verbose

set -e
set -o pipefail

module load g16
[ `cat /proc/cpuinfo | grep -m 1 vendor_id | awk '{{print $3}}'` == 'AuthenticAMD' ] && export PGI_FASTMATH_CPU=haswell
export GAUSS_SCRDIR=/tmp/${{SLURM_JOB_ID}}
mkdir -p $GAUSS_SCRDIR
g16 '{inputfile}'
"""

jobfile.write_text(jobfile_lines)

subprocess.run(["sbatch", str(jobfile)], check=True)

os.remove(jobfile)
